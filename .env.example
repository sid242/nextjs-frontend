
# Backend REST API. Called ONLY from the Next.js server (BFF); the browser never sees this URL.
API_URL=http://localhost:3000/api/v1

# Public backend origin the BROWSER connects to for Socket.IO. Read at runtime (no rebuild per environment).
SOCKET_URL=http://localhost:3000

# Extra origins allowed in CSP connect-src, comma separated (S3 uploads go browser -> S3).
CSP_CONNECT_EXTRA=https://*.amazonaws.com,http://localhost:9000

# Plan-Gated Multi-Tenant URL & BFF Configuration
BFF_SHARED_SECRET=bff-dev-shared-secret-key-min-16-chars
NEXT_PUBLIC_APP_BASE_DOMAIN=localhost:3001
NEXT_PUBLIC_APP_PROTOCOL=http
PLATFORM_HOST=localhost:3001
RESERVED_SUBDOMAINS=www,api,app,admin,platform,auth,static,cdn,mail,status
TRUST_PROXY=false

# Set to "false" ONLY when running the production build over plain http://localhost
# COOKIE_SECURE=false
